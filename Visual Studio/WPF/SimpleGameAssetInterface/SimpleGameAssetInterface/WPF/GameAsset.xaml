<Page x:Class="SimpleGameAssetInterface.GameAsset"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SimpleGameAssetInterface"
        xmlns:mvvm="clr-namespace:SimpleGameAssetInterface.MVVM"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=mvvm:WPFGameInfo, IsDesignTimeCreatable=True}"
        d:DesignHeight="600"
        d:DesignWidth="800"
        Title="Game Information">

    <Page.Resources>
        <!-- Modern Slim Web-Style ScrollBar Template -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <!-- Setting Width here affects the layout slot, but we force it inside the template below -->
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <!-- Force Width="4" on the container grid to override default system minimum widths -->
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true" Width="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <!-- Adjusted CornerRadius to 2 to match the new 4px width -->
                                                <Border x:Name="ThumbVisual" Background="#555555" CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="ThumbVisual" Property="Background" Value="#777777"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Define two columns for layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="150" MaxWidth="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Grid Grid.Column="0" Background="#303030">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Game title -->
            <Label x:Name="GameTitle" Content="{Binding Title, FallbackValue='Game Title (Design)'}" Margin="0, 10, 0, 0" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#e0e0e0" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />

            <!-- Rounded container for the artwork -->
            <Border x:Name="GameArtworkBorder"
                    Width="100"
                    Height="100"
                    Margin="0, 10, 0, 0"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Border.Background>
                    <ImageBrush x:Name="GameArtwork"
                            ImageSource="{Binding GameArtworkSource}"
                            d:ImageSource="/Resources/arcade.png"
                            Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Game release info -->
            <Label x:Name="GameReleaseInfo"
                    Content="{Binding ReleaseInfo, FallbackValue='Game release info (Design)'}"
                    Width="180"
                    Margin="0, 10, 0, 0"
                    Grid.Row="2"
                    Foreground="#e0e0e0"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Center" />

            <!-- Game description -->
            <ScrollViewer
                    MaxHeight="145"
                    VerticalScrollBarVisibility="Auto"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="0,0,10,0"
                    Grid.Row="3">
                <TextBlock
                        x:Name="GameDescription"
                        Text="{Binding Description, Mode=OneWay, FallbackValue='Game description (Design)'}"
                        Foreground="#b0b0b0"
                        FontSize="12"
                        TextWrapping="Wrap"
                        TextAlignment="Justify"/>
            </ScrollViewer>
        </Grid>

        <!-- Grid splitter -->
        <GridSplitter Width="4"
                      Background="#1D1D1D"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="CurrentAndNext"
                      ShowsPreview="False"/>

        <!-- Right panel -->
        <StackPanel  Grid.Column="1" Background="#202020">
            <StackPanel.Resources>
                <!-- Convertisseur magique WPF pour transformer un booléen en visibilité (Visible/Collapsed) -->
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
            </StackPanel.Resources>

            <!-- Press articles item -->
            <local:GameResourceItem Title="{Binding ArticlesSummaryTitle}"
                            Subtitle="{Binding ArticlesSummarySubtitle}"
                            LeftIcon="pack://application:,,,/Resources/square-library.png"
                            Visibility="{Binding HasArticles, Converter={StaticResource BoolToVis}}"
                            Click="ArticlesItem_Click"
                            VerticalAlignment="Top"
                            Margin="10, 10, 10, 5"/>

            <!-- Source code item -->
            <local:GameResourceItem Title="{Binding SourceCodeSummaryTitle}"
                            Subtitle="{Binding SourceCodeSummarySubtitle}"
                            LeftIcon="pack://application:,,,/Resources/code-xml.png"
                            Visibility="{Binding HasSourceCode, Converter={StaticResource BoolToVis}}"
                            Click="SourceCodeItem_Click"
                            VerticalAlignment="Top"
                            Margin="10, 10, 10, 5"/>
        </StackPanel>
    </Grid>
</Page>
