<Page x:Class="SimpleGameAssetInterface.WPF.GameArticlesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SimpleGameAssetInterface.WPF"
      xmlns:mvvm="clr-namespace:SimpleGameAssetInterface.MVVM"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=mvvm:WPFGameInfo, IsDesignTimeCreatable=True}"
      d:DesignWidth="800"
      d:DesignHeight="600"
      Title="GameArticlePage">

    <Grid Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Magic converter which allows WPF to transform a boolean into a visibility (Visible/Collapsed) -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="10">
            <!-- Source code icon -->
            <Image Source="pack://application:,,,/Resources/square-library.png"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10, 4, 0, 0" />

            <!-- Articles label -->
            <Label Content="Press articles"
                    Foreground="#e0e0e0"
                    FontSize="24"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Margin="10, 0, 0, 0" />
        </StackPanel>

        <!-- Gradient separator -->
        <Rectangle Grid.Row="1" Height="1" Margin="0,8,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#202020" Offset="0.0"/>
                    <GradientStop Color="#e0e0e0" Offset="0.5"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Dynamic Articles List Container -->
        <!-- NOTE row 2 captures the remaining vertical space and allows scrolling if the list is long -->
        <!-- NOTE margin bottom leaves room for the Back button -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="10,15,10,70">

            <!-- ItemsControl populates controls dynamically based on the ViewModel collection -->
            <ItemsControl ItemsSource="{Binding Articles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type mvvm:WPFGameArticleInfo}">

                        <!-- Reusable article item component -->
                        <!-- WPF will instantiate a GameArticleItem for each article. -->
                        <!-- The properties are dynamically binded. -->
                        <local:GameArticleItem ArticleIcon="{Binding ArticleArtworkSource}"
                                ArticleTitle="{Binding Title, FallbackValue='Agony (Design)'}"
                                OpenDocVisibility="{Binding HasLocalArticle}"
                                Margin="10, 4"/>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Back button -->
        <Button Style="{StaticResource ModernRoundedButton}"
                Content="&lt; Back"
                Grid.Row="2"
                Width="80"
                Height="32"
                Cursor="Hand"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0, 0, 20, 20"
                Click="BackBtn_Click" />
    </Grid>
</Page>
