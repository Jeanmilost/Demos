<UserControl x:Class="SimpleGameAssetInterface.WPF.GameArticleItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SimpleGameAssetInterface.WPF"
        mc:Ignorable="d"
        x:Name="Root"
        Cursor="Hand"
        d:DesignWidth="400"
        d:DesignHeight="60">
    <Border Background="#121212"
            BorderBrush="#222"
            BorderThickness="0, 0, 0, 1"
            Padding="15, 10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left icon -->
            <Image x:Name="ItemLeftIcon"
                    Grid.Column="0"
                    Source="{Binding ArticleIcon, ElementName=Root}"
                    d:Source="pack://application:,,,/Resources/square-library.png"
                    Width="24"
                    Height="24"
                    Margin="0, 0, 15, 0"/>

            <!-- Title and subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ItemTitle"
                        Text="{Binding ArticleTitle, ElementName=Root}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#e0e0e0"
                        d:Text="Press articles (3)"/>

                <!-- Buttons panel -->
                <Grid Margin="0, 2, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Open URL button -->
                    <Border Grid.Column="0"
                            Background="#505050"
                            CornerRadius="3"
                            Padding="8,3"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnOpenUrlClick"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Open URL"
                                   Foreground="#e0e0e0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Open document button -->
                    <Border Grid.Column="2"
                            Background="#505050"
                            CornerRadius="3"
                            Padding="8,3"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnOpenDocClick"
                            HorizontalAlignment="Right"
                            Visibility="{Binding OpenDocVisibility, ElementName=Root}">
                        <TextBlock Text="Open Document"
                                   Foreground="#e0e0e0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
